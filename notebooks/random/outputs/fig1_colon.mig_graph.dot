digraph  {
dpi=600;size=3.5;
colon [color="#6aa84f", fillcolor=white, fontname=Arial, penwidth="3.0", shape=box];
liver [color="#6fa8dc", fillcolor=white, fontname=Arial, penwidth="3.0", shape=box];
lung [color="#e69138", fillcolor=white, fontname=Arial, penwidth="3.0", shape=box];
lymph [color="#c27ba0", fillcolor=white, fontname=Arial, penwidth="3.0", shape=box];
colon -> lymph  [color="#6aa84f;0.5:#c27ba0", key=0, penwidth=3];
colon -> lymph  [color="#6aa84f;0.5:#c27ba0", key=1, penwidth=3];
lymph -> liver  [color="#c27ba0;0.5:#6fa8dc", key=0, penwidth=3];
lymph -> liver  [color="#c27ba0;0.5:#6fa8dc", key=1, penwidth=3];
lymph -> lung  [color="#c27ba0;0.5:#e69138", key=0, penwidth=3];
}
