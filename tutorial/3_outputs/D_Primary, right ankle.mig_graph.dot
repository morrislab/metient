"Locoregional skin metastasis 2,\n right leg" [shape=box, color="#c27ba0", fillcolor=white, fontname=Arial, penwidth=3.0];
"Primary,\n right ankle" -> "Locoregional skin metastasis 1,\n right ankle" [key=0, color="#6aa84f;0.5:#e69138", penwidth=3];
"Locoregional skin metastasis 1,\n right ankle" -> "Lymph node metastasis,\n right groin" [key=0, color="#e69138;0.5:#6fa8dc", penwidth=3];
"Locoregional skin metastasis 1,\n right ankle" -> "Locoregional skin metastasis 2,\n right leg" [key=0, color="#e69138;0.5:#c27ba0", penwidth=3];
