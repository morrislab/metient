digraph {
dpi=600;size=3.5;
"Primary,\n right ankle" [shape=box, color="#6aa84f", fillcolor=white, fontname=Arial, penwidth=3.0];
"Lymph node metastasis,\n right groin" [shape=box, color="#6fa8dc", fillcolor=white, fontname=Arial, penwidth=3.0];
