digraph {
dpi=600;size=3.5;
"Primary,\n right forearm" [shape=box, color="#6aa84f", fillcolor=white, fontname=Arial, penwidth=3.0];
"Lung metastasis" [shape=box, color="#6fa8dc", fillcolor=white, fontname=Arial, penwidth=3.0];
"Locoregional skin metastasis,\n axilla" [shape=box, color="#e69138", fillcolor=white, fontname=Arial, penwidth=3.0];
"Primary,\n right forearm" -> "Lung metastasis" [key=0, color="#6aa84f;0.5:#6fa8dc", penwidth=3];
"Primary,\n right forearm" -> "Lung metastasis" [key=1, color="#6aa84f;0.5:#6fa8dc", penwidth=3];
"Primary,\n right forearm" -> "Locoregional skin metastasis,\n axilla" [key=0, color="#6aa84f;0.5:#e69138", penwidth=3];
"Primary,\n right forearm" -> "Locoregional skin metastasis,\n axilla" [key=1, color="#6aa84f;0.5:#e69138", penwidth=3];
}
