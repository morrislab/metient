"Primary,\n mid-left back" -> "Lymph node metastasis,\n left axilla" [key=0, color="#6aa84f;0.5:#6fa8dc", penwidth=3];
"Primary,\n mid-left back" -> "Locoregional skin metastasis 1,\n left back" [key=0, color="#6aa84f;0.5:#e69138", penwidth=3];
"Primary,\n mid-left back" -> "Locoregional skin metastasis 1,\n left back" [key=1, color="#6aa84f;0.5:#e69138", penwidth=3];
"Primary,\n mid-left back" -> "Locoregional skin metastasis 2,\n left axilla" [key=0, color="#6aa84f;0.5:#c27ba0", penwidth=3];
